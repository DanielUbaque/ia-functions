LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

DATABASE_URL=postgresql://colflux:colflux@db:5432/colflux_ia

RETRIEVAL_TOP_K=4

# Servidores MCP registrados ("nombre=url,nombre2=url2"). Vacío = el agente
# corre solo con RAG, sin tools de datos del backend.
MCP_SERVERS=colflux-backend=http://mcp-backend:8000/mcp

# URL pública del backend Django ya desplegado, que consume mcp_server/.
BACKEND_API_BASE_URL=http://host.docker.internal:8000

# Solo se usan en docker-compose.yml (puertos publicados en el host y credenciales de Postgres).
# En el servidor, ajustar si el puerto por defecto ya está ocupado por otro servicio.
WEB_PORT=8001
DB_PORT=5433
MCP_PORT=8002
POSTGRES_USER=colflux
POSTGRES_PASSWORD=colflux
POSTGRES_DB=colflux_ia
