LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

DATABASE_URL=postgresql://colflux:colflux@db:5432/colflux_ia

RETRIEVAL_TOP_K=4

# Servidores MCP registrados ("nombre=url,nombre2=url2"). Vacío = el agente
# corre solo con RAG, sin tools de datos del backend.
MCP_SERVERS=colflux-backend=http://mcp-backend:8000/mcp

# URL del backend Django, que consume mcp_server/. En local con
# docker-compose apunta a host.docker.internal:8000 (puerto por defecto de
# `backend/docker-compose.yml` en desarrollo). EN PRODUCCIÓN (servidor
# 44.213.47.34) el backend real corre en el puerto 8001, no 8000 — ajustar
# en el .env real del servidor: BACKEND_API_BASE_URL=http://host.docker.internal:8001
BACKEND_API_BASE_URL=http://host.docker.internal:8000

# Solo se usan en docker-compose.yml (puertos publicados en el host y credenciales de Postgres).
# EN PRODUCCIÓN (servidor 44.213.47.34): WEB_PORT=8001 colisiona con el
# backend real, que ya usa ese puerto ahí (ver
# docs/arquitectura/guia-desarrollo-local.md, sección "servidor de
# producción" — puerto marcado como "pendiente, revisar al desplegar").
# Usar un puerto libre en el .env real del servidor, p. ej. WEB_PORT=8003
# (8000 y 8001 ya están tomados por los dos backends, 3000 por el frontend).
WEB_PORT=8001
DB_PORT=5433
MCP_PORT=8002
POSTGRES_USER=colflux
POSTGRES_PASSWORD=colflux
POSTGRES_DB=colflux_ia
